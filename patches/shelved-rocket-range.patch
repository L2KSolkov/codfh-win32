+def renamed_record(chunk, key8):
+    """A copy of a GodData record chunk under the key key8."""
+    c = bytearray(chunk)
+    c[12 + 16:12 + 24] = key8
+    return bytes(c)
+
+
+def soldier_copy(level, god, low, name, pos, facing, task_key, weapon=None, source=None):
+    """A copy of the kept soldier trigger, or of source, another soldier trigger chunk (see the
+    rocket range above): (its chunk, the name records it needs, its entity's name key). low: its
+    instance ID's last word, which keys its names too."""
+    sys.path.insert(0, SUITE)
+    from objects import packet
+    assets = god_records(god)[0]
+    own = next(c for kind, c in chunks_of(level) if kind == 0x704 and packet(c[16:])[1] == SOLDIER)
+    tmpl = source or own
+    cmds = {(o, k): raw for o, k, raw in packet(tmpl[16:])[2]}
+    words = [int(w, 16) for w in SOLDIER.split('-')]
+    records, edits = [], {}
+    for n, owner in enumerate(('SoldierTrigger', 'Trigger')):
+        key = struct.pack('<2I', low, 0xC0DE0000 + n)
+        # (the kept soldier's name records, which every copy has: one asked for and missing
+        # would hold the level start)
+        old = skey({(o, k): raw for o, k, raw in packet(own[16:])[2]}[owner, 0][:8])
+        if old in assets:
+            records.append(renamed_record(assets[old], key))
+        edits[owner, 0] = key
+    fx, fz = facing
+    edits['SoldierTrigger', 1] = name.encode() + b'\0'
+    edits['SoldierTrigger', 8] = task_key
+    edits['CSystemCommands', 1] = struct.pack('<16f', fz, 0, -fx, 0, 0, 1, 0, 0, fx, 0, fz, 0, pos[0], pos[1],
+                                              pos[2], 1)
+    if weapon:
+        edits['SoldierTrigger', 38] = weapon
+    if source:
+        # the kept soldier's: its creation script (BasicCreationTrigger, spawned by
+        # "CreateChild"), its links (Trigger 15) and SoldierTrigger 5 and 9. (Not 4: the German's,
+        # -1, marks its model record as one of the clump bank's, sub_B8000's command 3; with 0
+        # the level start waits for the model's bank parts for ever.)
+        mine = {(o, k): raw for o, k, raw in packet(own[16:])[2]}
+        for key in (('Trigger', 13), ('Trigger', 15), ('SoldierTrigger', 5), ('SoldierTrigger', 9)):
+            edits[key] = mine[key]
+    guid = struct.pack('<4I', words[0], words[1], words[2], low)
+    return rewrite_packet(tmpl, edits, guid), b''.join(records), edits['SoldierTrigger', 0]
+
+
+def soldier_team(assets, cmds):
+    """A soldier trigger's team: its character definition's (SoldierTrigger command 3, a kind-4
+    record of eight 12-byte references, the kind in the first word's top five bits) kind-8
+    reference's value record's key, or None."""
+    rec = assets.get(skey(cmds['SoldierTrigger', 3][:8]))
+    if not rec:
+        return None
+    data = record_data(rec)
+    for i in range(len(data) // 12):
+        w0, a, b = struct.unpack_from('<3I', data, i * 12)
+        if (w0 >> 27) == 8:
+            v = assets.get(skey(struct.pack('<2I', a, b)))
+            return record_data(v)[4:12] if v else None
+    return None
+
+
+def range_sources(level_dff, god):
+    """(shooter, target): the source level's soldier triggers the rocket range copies. The shooter
+    is one of its rocket launcher soldiers (SoldierTrigger 38's key SOLDIER_WEAPON's), of the kept
+    soldier's team if one is, else of any team but the Germans', else any; None if it has none
+    (the kept soldier's copy armed with it then: L_1_1_B, whose soldier never fires it). The
+    target is a soldier of another team (an enemy: a soldier attacks only one), with
+    ENEMY_CHARACTER's definition if one has it."""
+    sys.path.insert(0, SUITE)
+    from objects import packet
+    assets = god_records(god)[0]
+    soldiers = []
+    for kind, c in chunks_of(level_dff):
+        if kind == 0x704:
+            cls, guid, cmds = packet(c[16:])
+            if cls == 'SoldierTrigger':
+                d = {(o, k): raw for o, k, raw in cmds}
+                soldiers.append((c, guid, d, soldier_team(assets, d)))
+    mine = next(t for c, g, d, t in soldiers if g == SOLDIER)
+    german = struct.pack('<2I', 0x7C142BB6, 0x197563FC)
+    rockets = [x for x in soldiers if x[2].get(('SoldierTrigger', 38), b'')[:8] == SOLDIER_WEAPON[:8]]
+    shooter = (next((x for x in rockets if x[3] == mine), None) or
+               next((x for x in rockets if x[3] != german), None) or (rockets[0] if rockets else None))
+    s_team = shooter[3] if shooter else mine
+    enemies = [x for x in soldiers if x[3] != s_team and x not in rockets]
+    target = (next((x for x in enemies if x[2]['SoldierTrigger', 3][:8] == ENEMY_CHARACTER), None) or
+              (enemies[0] if enemies else None))
+    if target is None:
+        raise SystemExit('the source level has no soldier of another team than the shooter')
+    return (shooter[0] if shooter else None), target[0]
+
+
+def rocket_range(level, god, level_dff, matrix, y, template, trace=False):
+    """level and god with the rocket range's target and shooter added."""
+    import alfa
+    at, px, pz = matrix[8:11], matrix[12], matrix[14]
+    flen = math.hypot(at[0], at[2]) or 1.0
+    fx, fz = at[0] / flen, at[2] / flen
+    rx, rz = fz, -fx
+    target_pos = (px + fx * 1500.0, y, pz + fz * 1500.0)
+    shooter_pos = (px + rx * 300.0 + fx * 100.0, y, pz + rz * 300.0 + fz * 100.0)
+    dx, dz = target_pos[0] - shooter_pos[0], target_pos[2] - shooter_pos[2]
+    n = math.hypot(dx, dz) or 1.0
+    t_key = struct.pack('<2I', TARGET_GUID[0], 2)
+    s_key = struct.pack('<2I', SHOOTER_GUID[0], 2)
+    shooter_src, target_src = range_sources(level_dff, god)
+    c, recs, t_name = soldier_copy(level, god, TARGET_GUID[0], TARGET_GUID[1], target_pos, (-fx, -fz), t_key,
+                                   weapon=bytes(8) + struct.pack('<i', 0), source=target_src)
+    level += c
+    god += recs + alfa.god_record(template, t_key, target_task(TASK_ID + 1, trace))
+    c, recs, _ = soldier_copy(level, god, SHOOTER_GUID[0], SHOOTER_GUID[1], shooter_pos, (dx / n, dz / n), s_key,
+                              None if shooter_src else SOLDIER_WEAPON, source=shooter_src)
+    level += c
+    god += recs + alfa.god_record(template, s_key, shooter_task(TASK_ID + 2, t_name, trace=trace))
+    print('rocket range: target at (%.0f, %.0f), shooter at (%.0f, %.0f)%s' % (
+        target_pos[0], target_pos[2], shooter_pos[0], shooter_pos[2],
+        ' (a copy of a rocket launcher soldier)' if shooter_src else ' (the kept soldier armed with it)'))
+    return level, god
+

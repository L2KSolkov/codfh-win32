+def target_task(ident, trace=False, health=10000, every=0.25):
+    """The target's task: when it starts, the soldiers' setup (_setup: his own targeting off), nothing may damage it (SetCan*Damage(me, 0): flags of
+    its trigger), and then for ever its hit points set to health every every seconds
+    (SetHitPoints(me, health)), so that what does damage it never kills it. trace: marks 101
+    (started), 102 (flags set), 103 (each top-up, the first only)."""
+    import alfa
+    a = alfa.Asm()
+    a.wait_message(MSG_INITIALIZE, 1)
+    _mark(a, trace, 101)
+    _setup(a)                          # (his own targeting off: he stands, not closing in)
+    for cmd in CMD_SETCAN_DAMAGE:
+        a.command(CMD_GETMYAIOBJECTPOINTER)
+        a.push(0)
+        a.command(cmd)
+    _mark(a, trace, 102)
+    a.label('loop')
+    a.command(CMD_GETMYAIOBJECTPOINTER)
+    a.push(health)
+    a.command(CMD_SETHITPOINTS)
+    _wait(a, every)
+    a.jump('loop')
+    a.halt()
+    return alfa.task_image(ident, a.finish())
+
+
+def shooter_task(ident, target_name, again=10.0, trace=False):
+    """The shooter's task: when it starts (and a second on: his class takes a task only once it
+    is up), an endless clip (InfiniteAmmoClip 1), then every again seconds the target by its
+    name (SetTarget, its key's two words) and the order to shoot at it. trace: marks 201
+    (started), 202 (each order)."""
+    import alfa
+    a = alfa.Asm()
+    a.wait_message(MSG_INITIALIZE, 1)
+    _mark(a, trace, 201)
+    _setup(a)
+    _wait(a, 1.0)
+    a.push(1)
+    a.command(CMD_INFINITEAMMOCLIP)
+    a.label('loop')
+    a.queue(MSG_SETTARGET, list(struct.unpack('<2I', target_name)), CMD_GETMYAIOBJECTPOINTER)
+    a.queue(MSG_SHOOTATTARGET, [-1], CMD_GETMYAIOBJECTPOINTER)
+    _mark(a, trace, 202)
+    _wait(a, again)
+    a.jump('loop')
+    a.halt()
+    return alfa.task_image(ident, a.finish())
+
+
+def _wait(a, seconds):
+    """A GenericTimer of seconds (RegisterTimer seconds, GenericTimer, 0), then waiting for it."""
+    import alfa
+    a.push(alfa.f32(seconds))
+    a.push(MSG_GENERICTIMER)
+    a.push(0)
+    a.command(CMD_REGISTERTIMER)
+    a.pop(1)
+    a.wait_message(MSG_GENERICTIMER, 0x26)
+

+# The rocket range (alfa.py tasks too): a target soldier standing at a point 15 m ahead of the
+# player start, which neither explosions nor bullets damage, and a shooter beside the player
+# start with the rocket launcher, firing at it for ever. Each is a copy of the kept soldier's
+# trigger: its own instance ID, name keys (SoldierTrigger command 0, the entity's name, which
+# the spawned soldier registers itself under, unit_134B40.cpp; Trigger command 0, the
+# trigger's), each with a copy of the soldier's name record (GodData kind 9, tag 0x10B6), a
+# name shown over it, a matrix and a task. The shooter's task is the levels' own way to shoot
+# at a named entity (L_1_3_A's tasks): "SetTarget" (the name's two words: SoldierClass looks
+# the entity up, GetEntityFromName, and makes it its target, SetMyTarget), then
+# "SetTaskCommand_ShootAtTarget" (-1: its class's task 25, state 263, attacking standing).
+MSG_SETTARGET, MSG_SHOOTATTARGET = 80, 387
+CMD_INFINITEAMMOCLIP, CMD_SETHITPOINTS = 415, 426
+CMD_SETCAN_DAMAGE = (533, 534, 535, 536)   # explosions, bullets, enemies, allies may damage
+TARGET_GUID = (0xC0DE5001, 'debugging.target')
+# The target is an enemy (a soldier attacks only one): a copy of one of L_1_1_B's German soldiers'
+# triggers, with that character definition (SoldierTrigger command 3, a kind-4 record). Its own

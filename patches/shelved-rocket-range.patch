+# (791426F9,0575446A). (Not D808218A,C8B4C226: its chain reaches B5BDD800,5C428EF3, whose
+# references L_1_1_B's GodData does not hold, so the level start waits for them for ever.)
+ENEMY_CHARACTER = struct.pack('<2I', 0xCDB60D37, 0xB2A6DE7F)
+SHOOTER_GUID = (0xC0DE5002, 'debugging.shooter')

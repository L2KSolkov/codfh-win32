+# The source level's vehicles in a row in front of the player (--no-vehicles leaves them out):
+# a copy of the first trigger of each model (VehicleTrigger command 2) of its VehicleTriggers
+# (kind 7, spawned by their creation script, BasicCreationTrigger, on "CreateChild") and of its
+# first FlakTrigger (a VehicleTrigger that spawns a flak gun, sub_15A7B0). L_1_5: a T-34, a
+# Kettenkrad, a Panzer IV and a Flak 88; L_1_1_B has none. Each copy: its own instance ID, its
+# links to other triggers (Trigger 15: a count, then 16-byte IDs) and its names (VehicleTrigger
+# 0, Trigger 0) cleared, an unnamed one picked where the model has one, at its place on a line
+# across the player start's view (ahead, spacing apart), facing as the player does (its
+# matrix, CSystemCommands command 1).
+VEHICLE_LOW = 0xC0DEF1A0
+
+
+def vehicle_triggers(level_dff, matrix, y, packet, ahead=1200.0, spacing=800.0):
+    """([vehicle trigger chunks], [their classes]) for the source level's vehicle models."""
+    picked, flak = [], False
+    seen, named_models = set(), {}
+    for kind, c in chunks_of(level_dff):
+        if kind != 0x704:
+            continue
+        cls, guid, cmds = packet(c[16:])
+        if cls == 'FlakTrigger' and not flak:
+            flak = True
+            picked.append((c, cls, guid))
+        elif cls == 'VehicleTrigger':
+            model = next((raw for o, k, raw in cmds if o == 'VehicleTrigger' and k == 2), b'')
+            named = any(o in ('VehicleTrigger', 'Trigger') and k == 0 and any(raw) for o, k, raw in cmds)
+            if model not in seen:
+                seen.add(model)
+                picked.append((c, cls, guid))
+            elif not named and model in named_models:
+                # (an unnamed one in place of a named one: a named vehicle is a soldier's, his
+                # SoldierTrigger 37, L_1_5's T-34 Petrov's, and the player started in its copy)
+                picked[named_models.pop(model)] = (c, cls, guid)
+            if named and model not in named_models and picked[-1][0] is c:
+                named_models[model] = len(picked) - 1
+    at, px, pz = matrix[8:11], matrix[12], matrix[14]
+    flen = math.hypot(at[0], at[2]) or 1.0
+    fx, fz = at[0] / flen, at[2] / flen
+    rx, rz = fz, -fx
+    out = []
+    for i, (c, cls, guid) in enumerate(picked):
+        off = (i - (len(picked) - 1) / 2.0) * spacing
+        pos = (px + fx * ahead + rx * off, y, pz + fz * ahead + rz * off)
+        m = struct.pack('<16f', fz, 0, -fx, 0, 0, 1, 0, 0, fx, 0, fz, 0, pos[0], pos[1], pos[2], 1)
+        words = [int(w, 16) for w in guid.split('-')]
+        out.append(rewrite_packet(c, {('Trigger', 15): struct.pack('<I', 0), ('CSystemCommands', 1): m,
+                                      ('VehicleTrigger', 0): bytes(8), ('Trigger', 0): bytes(8)},
+                                  struct.pack('<4I', words[0], words[1], words[2], VEHICLE_LOW + i)))
+    return out, [cls for c, cls, guid in picked]
+

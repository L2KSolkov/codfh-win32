+    def collision(self):
+        """(vertices, triangles) of the solid faces."""
+        verts, tris = [], []
+        for pts, colour, solid in self.faces:
+            if not solid:
+                continue
+            b = len(verts)
+            verts += pts
+            tris += [(b, b + k, b + k + 1) for k in range(1, len(pts) - 1)]
+        return verts, tris

+static type_3DC9B0 *MountedWeaponOf(Trigger *pTrigger)
+{
+    RwInt32 i;
+
+    for (i = 0; i < 768; i++)
+    {
+        type_3D3548 *pEntity = dword_4B6A00[i].unk_04;
+
+        if (pEntity && ((pEntity->unk_2C >> 19) & 1) && (Trigger *)pEntity->get_unk_34C() == pTrigger)

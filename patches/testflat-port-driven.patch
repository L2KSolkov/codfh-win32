+        centre = _mean([p for f in faces for p in f])
+        for f in faces:
+            n = _cross(_sub(f[1], f[0]), _sub(f[2], f[0]))
+            if _dot(n, _sub(_mean(f), centre)) < 0:
+                f = f[::-1]

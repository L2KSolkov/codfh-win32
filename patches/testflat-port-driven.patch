+        faces = [[(u, v, h1) for u, v in base]]
+        faces += [[(base[i][0], base[i][1], h0), (base[(i + 1) % 4][0], base[(i + 1) % 4][1], h0),
+                   (base[(i + 1) % 4][0], base[(i + 1) % 4][1], h1), (base[i][0], base[i][1], h1)] for i in range(4)]
